# ---------------------------------------------------------------------------
# Nine Licious - contoh environment PRODUCTION
#
# Salin file ini menjadi .env.production.local, lalu isi nilainya.
# File .env.production.local tidak boleh di-commit.
#
# Build production memakai file ini. Pembayaran hanya dianggap berhasil setelah
# webhook Midtrans terverifikasi di server.
# ---------------------------------------------------------------------------

# Supabase - project utama
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# HANYA untuk server. Jangan pernah memakai prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Aplikasi
NEXT_PUBLIC_APP_URL=https://pos.example.com
SESSION_IDLE_MINUTES=30
# Salt untuk hash IP pada audit log. Gunakan nilai acak yang panjang.
AUDIT_IP_SALT=

# Midtrans - production wajib memakai Production
MIDTRANS_ENABLED=false
MIDTRANS_ENV=production
# HANYA untuk server. Jangan pernah memakai prefix NEXT_PUBLIC_.
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
